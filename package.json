{
	"name": "back-to-top-block",
	"version": "1.0.5",
	"description": "A WordPress block that adds a customizable back-to-top button to help visitors return to the top of the page.",
	"author": "philhoyt",
	"repository": {
		"type": "git",
		"url": "https://github.com/philhoyt/Back-to-Top-Block"
	},
	"license": "GPL-2.0-or-later",
	"main": "build/index.js",
	"prettier": "@wordpress/prettier-config",
	"scripts": {
		"build": "wp-scripts build",
		"format": "wp-scripts format",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js",
		"lint:php": "composer lint",
		"lint": "npm run lint:css && npm run lint:js && npm run lint:php",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "wp-scripts plugin-zip",
		"start": "wp-scripts start",
		"env:start": "wp-env start",
		"env:stop": "wp-env stop",
		"test:unit:js": "wp-scripts test-unit-jest",
		"test:unit:php": "wp-env run tests-cli --env-cwd=wp-content/plugins/Back-to-Top-Block php ./vendor/bin/phpunit"
	},
	"files": [
		"build",
		"readme.txt",
		"back-to-top-block.php"
	],
	"devDependencies": {
		"@babel/core": "^7.25.7",
		"@wordpress/babel-preset-default": "^8.55.0",
		"@wordpress/element": "^8.0.1",
		"@wordpress/env": "^12.1.0",
		"@wordpress/eslint-plugin": "^28.1.0",
		"@wordpress/i18n": "^6.21.1",
		"@wordpress/jest-preset-default": "^14.2.0",
		"@wordpress/scripts": "^37.1.0",
		"@wordpress/stylelint-config": "^27.1.0",
		"@wordpress/url": "^4.48.1",
		"babel-jest": "^30.5.0",
		"eslint-plugin-jest": "^29.17.0",
		"jest": "^30.5.0",
		"jest-environment-jsdom": "^30.5.0"
	}
}
